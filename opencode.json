{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "playwright-extension": {
      "type": "local",
      "command": ["bash", "scripts/start-playwright-mcp.sh"],
      "enabled": true
    }
  }
}
